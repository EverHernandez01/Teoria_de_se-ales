        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy import signal\n",
        "from scipy.fft import fft, fftfreq, fftshift\n",
        "\n",
        "# Parámetros de simulación\n",
        "fs = 1000  # Frecuencia de muestreo [Hz]\n",
        "T = 1.0    # Duración de la señal [s]\n",
        "N = int(fs * T)  # Número de muestras\n",
        "t = np.linspace(0, T, N, endpoint=False)\n",
        "\n",
        "# ==================================================\n",
        "# ETAPA 0: Señal de entrada - Ruido blanco gaussiano\n",
        "# ==================================================\n",
        "print(\"Generando ruido blanco gaussiano (Etapa 0)...\")\n",
        "\n",
        "np.random.seed(42)  # Para reproducibilidad\n",
        "x = np.random.randn(N)\n",
        "\n",
        "# ==================================================\n",
        "# ETAPA 1: Filtrado pasa-bajas RC\n",
        "# ==================================================\n",
        "print(\"Aplicando filtro pasa-bajas RC (Etapa 1)...\")\n",
        "\n",
        "# Parámetros del filtro RC\n",
        "fc = 50  # Frecuencia de corte [Hz]\n",
        "tau = 1 / (2 * np.pi * fc)  # Constante de tiempo RC\n",
        "\n",
        "# Diseño del filtro RC\n",
        "alpha = 1 / (1 + tau * fs)\n",
        "a = [1, -(1 - alpha)]\n",
        "b = [alpha, 0]\n",
        "\n",
        "# Aplicar filtro a la señal\n",
        "x1 = signal.lfilter(b, a, x)\n",
        "\n",
        "# ==================================================\n",
        "# ETAPA 2: MODULACIÓN\n",
        "# ==================================================\n",
        "print(\"Aplicando modulación de amplitud (Etapa 2)...\")\n",
        "\n",
        "# Parámetros de modulación\n",
        "f0 = 200  # Frecuencia de la portadora [Hz]\n",
        "Ts = 1/fs  # Período de muestreo\n",
        "\n",
        "# Señal portadora\n",
        "carrier = np.cos(2 * np.pi * f0 * t)\n",
        "\n",
        "# Modulación: x2[n] = x1[n] * cos(2π f0 n Ts)\n",
        "x2 = x1 * carrier\n",
        "\n",
        "# Funciones auxiliares (mismas que antes)\n",
        "def autocorrelation(signal_data, max_lag=None):\n",
        "    \"\"\"Calcula la autocorrelación de una señal.\"\"\"\n",
        "    if max_lag is None:\n",
        "        max_lag = len(signal_data) // 2\n",
        "    lags = np.arange(-max_lag, max_lag + 1)\n",
        "    acf = np.correlate(signal_data - np.mean(signal_data),\n",
        "                       signal_data - np.mean(signal_data), mode='full')\n",
        "    acf = acf[len(acf)//2 - max_lag:len(acf)//2 + max_lag + 1]\n",
        "    acf /= acf[max_lag]\n",
        "    return lags, acf\n",
        "\n",
        "def calculate_psd(signal_data, fs, nperseg=256):\n",
        "    \"\"\"Calcula la PSD usando el método de Welch.\"\"\"\n",
        "    f, Pxx = signal.welch(signal_data, fs, nperseg=nperseg,\n",
        "                          window='hamming', scaling='density')\n",
        "    return f, Pxx\n",
        "\n",
        "# Calcular métricas para todas las etapas\n",
        "lags_0, acf_0 = autocorrelation(x, max_lag=100)\n",
        "lags_1, acf_1 = autocorrelation(x1, max_lag=100)\n",
        "lags_2, acf_2 = autocorrelation(x2, max_lag=100)\n",
        "\n",
        "f_0, psd_0 = calculate_psd(x, fs)\n",
        "f_1, psd_1 = calculate_psd(x1, fs)\n",
        "f_2, psd_2 = calculate_psd(x2, fs)\n",
        "\n",
        "# Respuesta en frecuencia del filtro\n",
        "w, h = signal.freqz(b, a, worN=8000, fs=fs)\n",
        "\n",
        "# ==================================================\n",
        "# VISUALIZACIÓN DE RESULTADOS\n",
        "# ==================================================\n",
        "print(\"Generando gráficos...\")\n",
        "\n",
        "plt.style.use('default')\n",
        "fig = plt.figure(figsize=(16, 14))\n",
        "\n",
        "# 1. SEÑALES EN EL TIEMPO\n",
        "# Ruido blanco (Etapa 0)\n",
        "ax1 = plt.subplot(4, 3, 1)\n",
        "ax1.plot(t[:300], x[:300], 'b-', alpha=0.7, linewidth=0.8)\n",
        "ax1.set_title('Etapa 0: Ruido blanco')\n",
        "ax1.set_xlabel('Tiempo [s]')\n",
        "ax1.set_ylabel('Amplitud')\n",
        "ax1.grid(True, alpha=0.3)\n",
        "\n",
        "# Señal filtrada (Etapa 1)\n",
        "ax2 = plt.subplot(4, 3, 2)\n",
        "ax2.plot(t[:300], x1[:300], 'r-', alpha=0.7, linewidth=0.8)\n",
        "ax2.set_title(f'Etapa 1: Filtrada RC (fc={fc} Hz)')\n",
        "ax2.set_xlabel('Tiempo [s]')\n",
        "ax2.set_ylabel('Amplitud')\n",
        "ax2.grid(True, alpha=0.3)\n",
        "\n",
        "# Señal modulada (Etapa 2)\n",
        "ax3 = plt.subplot(4, 3, 3)\n",
        "ax3.plot(t[:300], x2[:300], 'g-', alpha=0.7, linewidth=0.8)\n",
        "ax3.plot(t[:300], x1[:300], 'r--', alpha=0.5, linewidth=0.5, label='Envolvente (x1)')\n",
        "ax3.plot(t[:300], -x1[:300], 'r--', alpha=0.5, linewidth=0.5)\n",
        "ax3.set_title(f'Etapa 2: Modulada AM (f0={f0} Hz)')\n",
        "ax3.set_xlabel('Tiempo [s]')\n",
        "ax3.set_ylabel('Amplitud')\n",
        "ax3.grid(True, alpha=0.3)\n",
        "ax3.legend()\n",
        "\n",
        "# 2. AUTOCORRELACIÓN (ACF)\n",
        "ax4 = plt.subplot(4, 3, 4)\n",
        "ax4.stem(lags_0, acf_0, basefmt=' ', linefmt='b-', markerfmt='bo')\n",
        "ax4.set_title('Etapa 0: ACF - Delta')\n",
        "ax4.set_xlabel('Lag [muestras]')\n",
        "ax4.set_ylabel('Rxx[θ]')\n",
        "ax4.set_xlim([-50, 50])\n",
        "ax4.set_ylim([-0.2, 1.2])\n",
        "ax4.grid(True, alpha=0.3)\n",
        "\n",
        "ax5 = plt.subplot(4, 3, 5)\n",
        "ax5.stem(lags_1, acf_1, basefmt=' ', linefmt='r-', markerfmt='ro')\n",
        "ax5.set_title('Etapa 1: ACF - Ensanchada')\n",
        "ax5.set_xlabel('Lag [muestras]')\n",
        "ax5.set_ylabel('Rxx[θ]')\n",
        "ax5.set_xlim([-50, 50])\n",
        "ax5.set_ylim([-0.2, 1.2])\n",
        "ax5.grid(True, alpha=0.3)\n",
        "\n",
        "ax6 = plt.subplot(4, 3, 6)\n",
        "ax6.plot(lags_2, acf_2, 'g-', linewidth=1.5, label='ACF modulada')\n",
        "ax6.plot(lags_1, acf_1 * np.cos(2*np.pi*f0*lags_1/fs), 'k--',\n",
        "         linewidth=1, alpha=0.7, label='Teórica: R₁(τ)·cos(2πf₀τ)')\n",
        "ax6.set_title('Etapa 2: ACF - Oscilatoria')\n",
        "ax6.set_xlabel('Lag [muestras]')\n",
        "ax6.set_ylabel('Rxx[θ]')\n",
        "ax6.set_xlim([-50, 50])\n",
        "ax6.set_ylim([-1.2, 1.2])\n",
        "ax6.grid(True, alpha=0.3)\n",
        "ax6.legend()\n",
        "\n",
        "# 3. DENSIDAD ESPECTRAL DE POTENCIA (PSD)\n",
        "ax7 = plt.subplot(4, 3, 7)\n",
        "ax7.semilogy(f_0, psd_0, 'b-', linewidth=1.5)\n",
        "ax7.set_title('Etapa 0: PSD - Plana')\n",
        "ax7.set_xlabel('Frecuencia [Hz]')\n",
        "ax7.set_ylabel('Densidad [dB/Hz]')\n",
        "ax7.set_xlim([0, fs/2])\n",
        "ax7.grid(True, alpha=0.3)\n",
        "ax7.axhline(y=np.var(x)*2/fs, color='k', linestyle='--', alpha=0.5)\n",
        "\n",
        "ax8 = plt.subplot(4, 3, 8)\n",
        "ax8.semilogy(f_1, psd_1, 'r-', linewidth=1.5, label='PSD filtrada')\n",
        "ax8.semilogy(w, np.abs(h)**2 * np.var(x)*2/fs, 'k--', linewidth=1,\n",
        "             alpha=0.7, label='|H(f)|² teórico')\n",
        "ax8.set_title(f'Etapa 1: PSD - Banda limitada')\n",
        "ax8.set_xlabel('Frecuencia [Hz]')\n",
        "ax8.set_ylabel('Densidad [dB/Hz]')\n",
        "ax8.set_xlim([0, fs/2])\n",
        "ax8.grid(True, alpha=0.3)\n",
        "ax8.legend()\n",
        "\n",
        "ax9 = plt.subplot(4, 3, 9)\n",
        "ax9.semilogy(f_2, psd_2, 'g-', linewidth=1.5, label='PSD modulada')\n",
        "# Calcular PSD teórica de la modulación\n",
