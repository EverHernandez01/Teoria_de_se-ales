        "\n",
        "# ==================================================\n",
        "# ETAPA 1: Filtrado pasa-bajas RC\n",
        "# ==================================================\n",
        "print(\"🔹 Aplicando filtro pasa-bajas RC (Etapa 1)...\")\n",
        "\n",
        "fc = 50  # Frecuencia de corte [Hz]\n",
        "tau = 1 / (2 * np.pi * fc)\n",
        "\n",
        "# Diseño del filtro RC\n",
        "alpha = 1 / (1 + tau * fs)\n",
        "b = [alpha, 0]\n",
        "a = [1, -(1 - alpha)]\n",
        "\n",
        "# Aplicar filtro\n",
        "x1 = signal.lfilter(b, a, x)\n",
        "\n",
        "# ==================================================\n",
        "# ETAPA 2: MODULACIÓN AM\n",
        "# ==================================================\n",
        "print(\"🔹 Aplicando modulación AM (Etapa 2)...\")\n",
        "\n",
        "f0 = 400  # Frecuencia de portadora [Hz] (aumentada para mejor visualización)\n",
        "carrier = np.cos(2 * np.pi * f0 * t)\n",
        "x2 = x1 * carrier\n",
        "\n",
        "# ==================================================\n",
        "# ETAPA 3: DEMODULACIÓN - DETECTOR DE ENVOLVENTE\n",
        "# ==================================================\n",
        "print(\"🔹 Aplicando demodulación por detector de envolvente (Etapa 3)...\")\n",
        "\n",
        "# Método 1: Rectificación de onda completa\n",
        "x2_rectified = np.abs(x2)\n",
        "\n",
        "# Método 2: Filtro pasa-bajas para suavizar (mismo filtro RC)\n",
