        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy import signal\n",
        "from scipy.fft import fft, fftfreq, fftshift\n",
        "\n",
        "# Parámetros de simulación\n",
        "fs = 1000  # Frecuencia de muestreo [Hz]\n",
        "T = 1.0    # Duración de la señal [s]\n",
        "N = int(fs * T)  # Número de muestras\n",
        "t = np.linspace(0, T, N, endpoint=False)\n",
        "\n",
        "# ==================================================\n",
        "# ETAPA 0: Señal de entrada - Ruido blanco gaussiano\n",
        "# ==================================================\n",
        "print(\"Generando ruido blanco gaussiano (Etapa 0)...\")\n",
        "\n",
        "# Ruido blanco con media cero y varianza unitaria\n",
        "np.random.seed(42)  # Para reproducibilidad\n",
        "x = np.random.randn(N)\n",
        "\n",
        "# Cálculo de ACF (autocorrelación)\n",
        "def autocorrelation(x, max_lag=None):\n",
        "    \"\"\"Calcula la autocorrelación de una señal.\"\"\"\n",
        "    if max_lag is None:\n",
        "        max_lag = len(x) // 2\n",
        "    lags = np.arange(-max_lag, max_lag + 1)\n",
        "    acf = np.correlate(x - np.mean(x), x - np.mean(x), mode='full')\n",
        "    acf = acf[len(acf)//2 - max_lag:len(acf)//2 + max_lag + 1]\n",
        "    acf /= acf[max_lag]  # Normalizar por el valor en lag=0\n",
        "    return lags, acf\n",
        "\n",
        "# Cálculo de PSD usando el periodograma de Welch\n",
        "def calculate_psd(signal_data, fs, nperseg=256):\n",
        "    \"\"\"Calcula la PSD usando el método de Welch.\"\"\"\n",
        "    f, Pxx = signal.welch(signal_data, fs, nperseg=nperseg,\n",
        "                          window='hamming', scaling='density')\n",
        "    return f, Pxx\n",
        "\n",
        "# Calcular ACF y PSD para Etapa 0\n",
        "lags_0, acf_0 = autocorrelation(x, max_lag=50)\n",
        "f_0, psd_0 = calculate_psd(x, fs)\n",
        "\n",
        "# ==================================================\n",
        "# ETAPA 1: Filtrado pasa-bajas RC\n",
        "# ==================================================\n",
        "print(\"Aplicando filtro pasa-bajas RC (Etapa 1)...\")\n",
        "\n",
        "# Parámetros del filtro RC\n",
        "fc = 50  # Frecuencia de corte [Hz]\n",
        "tau = 1 / (2 * np.pi * fc)  # Constante de tiempo RC\n",
        "\n",
        "# Diseño del filtro RC como filtro IIR de primer orden\n",
        "# H(s) = 1/(1 + s*tau) -> Discretización bilineal\n",
        "alpha = 1 / (1 + tau * fs)  # Coeficiente del filtro\n",
        "a = [1, -(1 - alpha)]  # Coeficientes del denominador\n",
        "b = [alpha, 0]         # Coeficientes del numerador\n",
        "\n",
        "# Aplicar filtro a la señal\n",
        "x1 = signal.lfilter(b, a, x)\n",
        "\n",
        "# Respuesta en frecuencia del filtro\n",
        "w, h = signal.freqz(b, a, worN=8000, fs=fs)\n",
        "\n",
        "# Calcular ACF y PSD para Etapa 1\n",
        "lags_1, acf_1 = autocorrelation(x1, max_lag=50)\n",
        "f_1, psd_1 = calculate_psd(x1, fs)\n",
        "\n",
        "# ==================================================\n",
        "# VISUALIZACIÓN DE RESULTADOS\n",
        "# ==================================================\n",
        "print(\"Generando gráficos...\")\n",
        "\n",
        "plt.style.use('default')\n",
        "fig = plt.figure(figsize=(14, 12))\n",
        "\n",
        "# 1. Señales en el tiempo (primeras 200 muestras)\n",
        "ax1 = plt.subplot(4, 2, 1)\n",
        "ax1.plot(t[:200], x[:200], 'b-', alpha=0.7, linewidth=0.8)\n",
        "ax1.set_title('Etapa 0: Ruido blanco (primeras 200 muestras)')\n",
        "ax1.set_xlabel('Tiempo [s]')\n",
        "ax1.set_ylabel('Amplitud')\n",
        "ax1.grid(True, alpha=0.3)\n",
        "\n",
        "ax2 = plt.subplot(4, 2, 2)\n",
        "ax2.plot(t[:200], x1[:200], 'r-', alpha=0.7, linewidth=0.8)\n",
        "ax2.set_title(f'Etapa 1: Señal filtrada RC (fc={fc} Hz)')\n",
        "ax2.set_xlabel('Tiempo [s]')\n",
        "ax2.set_ylabel('Amplitud')\n",
        "ax2.grid(True, alpha=0.3)\n",
        "\n",
        "# 2. Autocorrelación (ACF)\n",
        "ax3 = plt.subplot(4, 2, 3)\n",
        "ax3.stem(lags_0, acf_0, basefmt=' ', linefmt='b-', markerfmt='bo')\n",
        "ax3.set_title('Etapa 0: ACF - Ruido blanco')\n",
        "ax3.set_xlabel('Lag [muestras]')\n",
        "ax3.set_ylabel('Rxx[θ]')\n",
        "ax3.set_ylim([-0.2, 1.2])\n",
        "ax3.grid(True, alpha=0.3)\n",
        "ax3.axhline(y=0, color='k', linestyle='-', alpha=0.3)\n",
        "\n",
        "ax4 = plt.subplot(4, 2, 4)\n",
        "ax4.stem(lags_1, acf_1, basefmt=' ', linefmt='r-', markerfmt='ro')\n",
        "ax4.set_title('Etapa 1: ACF - Señal filtrada (ensanchada)')\n",
        "ax4.set_xlabel('Lag [muestras]')\n",
        "ax4.set_ylabel('Rxx[θ]')\n",
        "ax4.set_ylim([-0.2, 1.2])\n",
        "ax4.grid(True, alpha=0.3)\n",
        "ax4.axhline(y=0, color='k', linestyle='-', alpha=0.3)\n",
        "\n",
        "# 3. Densidad Espectral de Potencia (PSD)\n",
        "ax5 = plt.subplot(4, 2, 5)\n",
        "ax5.semilogy(f_0, psd_0, 'b-', linewidth=1.5)\n",
        "ax5.set_title('Etapa 0: PSD - Ruido blanco (plana)')\n",
        "ax5.set_xlabel('Frecuencia [Hz]')\n",
        "ax5.set_ylabel('Densidad espectral [dB/Hz]')\n",
        "ax5.set_xlim([0, fs/2])\n",
        "ax5.grid(True, alpha=0.3)\n",
        "# Línea de referencia del valor esperado\n",
        "ax5.axhline(y=np.var(x)*2/fs, color='k', linestyle='--', alpha=0.5, label='Teórico')\n",
        "ax5.legend()\n",
        "\n",
        "ax6 = plt.subplot(4, 2, 6)\n",
        "ax6.semilogy(f_1, psd_1, 'r-', linewidth=1.5, label='PSD medida')\n",
        "# Superponer respuesta en frecuencia del filtro\n",
        "ax6.semilogy(w, np.abs(h)**2 * np.var(x)*2/fs, 'g--', linewidth=1.5,\n",
        "             label='|H(f)|² (teórico)')\n",
        "ax6.set_title(f'Etapa 1: PSD - Banda limitada (fc={fc} Hz)')\n",
        "ax6.set_xlabel('Frecuencia [Hz]')\n",
        "ax6.set_ylabel('Densidad espectral [dB/Hz]')\n",
        "ax6.set_xlim([0, fs/2])\n",
        "ax6.grid(True, alpha=0.3)\n",
        "ax6.legend()\n",
        "\n",
        "# 4. Respuesta en frecuencia del filtro\n",
        "ax7 = plt.subplot(4, 2, 7)\n",
        "ax7.semilogy(w, np.abs(h), 'g-', linewidth=2)\n",
        "ax7.set_title('Respuesta en frecuencia del filtro RC')\n",
        "ax7.set_xlabel('Frecuencia [Hz]')\n",
        "ax7.set_ylabel('|H(f)|')\n",
        "ax7.set_xlim([0, fs/2])\n",
        "ax7.grid(True, alpha=0.3)\n",
        "ax7.axvline(x=fc, color='k', linestyle='--', alpha=0.5, label=f'fc={fc} Hz')\n",
        "ax7.legend()\n",
        "\n",
        "# 5. Histogramas para verificar distribución\n",
        "ax8 = plt.subplot(4, 2, 8)\n",
        "ax8.hist(x, bins=50, density=True, alpha=0.5, color='b', label='Ruido blanco')\n",
        "ax8.hist(x1, bins=50, density=True, alpha=0.5, color='r', label='Filtrado RC')\n",
        "ax8.set_title('Distribución de amplitudes')\n",
        "ax8.set_xlabel('Amplitud')\n",
        "ax8.set_ylabel('Densidad de probabilidad')\n",
        "ax8.grid(True, alpha=0.3)\n",
        "ax8.legend()\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# ==================================================\n",
        "# ANÁLISIS ESTADÍSTICO\n",
